{
  "name": "v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm run ci",
    "build": "next build",
    "start": "next start",
    "ci": "concurrently \"pnpm run check:style\" \"pnpm run check:build\"",
    "check:build": "tsc -p tsconfig.json --noEmit",
    "check:style": "concurrently \"pnpm run check:format\" \"pnpm run check:lint\"",
    "check:format": "prettier --check \"*.{js,cjs,mjs,ts,cts,mts}\" \"{app,src}/**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}\"",
    "check:lint": "eslint \"{app,src}/**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}\"",
    "style": "concurrently \"pnpm run format\" \"pnpm run lint\"",
    "lint": "pnpm run check:lint --fix",
    "format": "prettier --write \"*.{js,cjs,mjs,ts,cts,mts}\" \"{app,src}/**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cn": "^0.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lexjs/eslint": "^3.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.11.2"
}
